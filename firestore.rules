rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public catalog data — readable by anyone. Writable by anyone too, since
    // the admin panel is gated by an app-level password, not Firebase Auth,
    // so Firestore rules can't tell "admin" apart from "customer" here.
    match /products/{id}   { allow read: if true; allow write: if true; }
    match /coupons/{id}    { allow read: if true; allow write: if true; }
    match /settings/{id}   { allow read: if true; allow write: if true; }
    match /reviews/{id}    { allow read: if true; allow write: if true; }

    // orders — anyone can create an order (checkout is guest-friendly), and
    // reads are open too: admin.html needs to see every order and has no
    // Firebase Auth to check against (same trade-off as everywhere else in
    // this file). This does mean order details (name, phone, address) are
    // technically readable by anyone who queries this collection directly —
    // real protection would need Firebase Auth for admin, a bigger change.
    match /orders/{id} {
      allow create: if true;
      allow read: if true;
      allow update: if true;
    }

    // admin password — kept OUT of settings/main (which every storefront page
    // reads publicly) so it isn't exposed in normal browsing traffic. Still
    // technically readable by anyone who specifically queries this path —
    // real protection would need Firebase Auth for admin, a bigger change.
    match /adminConfig/{id} { allow read, write: if true; }

    // customers — only the owner can read/write their own doc
    match /customers/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // per-user cart/wishlist sync — only the owner can read/write their own
    match /userCarts/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // newsletter/stock alerts/contact form — anyone can submit; admin needs to
    // read these back (admin.html has no Firebase Auth to check against, same
    // trade-off as products/orders/settings above).
    match /newsletter/{id}   { allow create: if true; allow read: if true; }
    match /stockAlerts/{id}  { allow create: if true; allow read: if true; }
    match /contactMessages/{id} { allow create: if true; allow read: if true; }

    // custom tailoring requests — same trade-off as orders above
    match /customOrders/{id} {
      allow create: if true;
      allow read: if true;
      allow update: if true;
    }
  }
}
